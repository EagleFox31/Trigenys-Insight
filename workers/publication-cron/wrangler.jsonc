{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trigenys-insight-publisher",
  "main": "index.mjs",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "keep_vars": true,
}
