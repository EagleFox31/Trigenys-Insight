# PostgreSQL connection string
DATABASE_URL=postgresql://trigenys:trigenys@127.0.0.1:5432/trigenys_insight
# Direct connection for migrations. On Neon, DATABASE_URL uses the -pooler host;
# DATABASE_URL_UNPOOLED uses the direct host from the same branch.
DATABASE_URL_UNPOOLED=postgresql://trigenys:trigenys@127.0.0.1:5432/trigenys_insight

# Use long, random values outside local development.
PAYLOAD_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
PREVIEW_SECRET=replace-with-a-long-random-secret

# Public origin, without a trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional profile URL overrides. The verified Group LinkedIn, Facebook and Instagram
# profiles have built-in defaults. Threads stays hidden until its link is supplied.
NEXT_PUBLIC_TRIGENYS_LINKEDIN_URL=
NEXT_PUBLIC_TRIGENYS_FACEBOOK_URL=
NEXT_PUBLIC_TRIGENYS_INSTAGRAM_URL=
NEXT_PUBLIC_TRIGENYS_THREADS_URL=

# Vercel Blob token. Leave empty locally to keep filesystem uploads enabled.
BLOB_READ_WRITE_TOKEN=

# Optional IndexNow key for notifying Bing and other participating engines when
# published editorial URLs change. Use 8-128 letters, numbers, or dashes.
INDEXNOW_KEY=
